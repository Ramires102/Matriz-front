{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matriz-front",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://matriz-backend-1rsi.onrender.com"
  },
  "observability": {
    "enabled": true
  }
}
